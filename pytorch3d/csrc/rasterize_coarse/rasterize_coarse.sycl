#include "pulsar/global.h"
#include <ATen/ATen.h>
#include <c10/core/DeviceGuard.h>
#include <c10/xpu/XPUStream.h>
#include <sycl/sycl.hpp>
#include "rasterize_points/rasterization_utils_sycl.h"
#include "utils/float_math_sycl.h"
#include "utils/geometry_utils_sycl.h"

#include <cstdint>
#include <tuple>

namespace {

using namespace sycl;
using namespace pytorch3d::float_math_sycl;
using namespace pytorch3d::geometry_utils_sycl;
using namespace pytorch3d::rasterization_utils_sycl;

class TriangleBoundingBoxKernel;
class RasterizeCoarseSyclKernel;

inline void TriangleBoundingBoxSyclKernelBody(
    const int tid,
    const int F,
    const float blur_radius,
    const float* face_verts_ptr,
    float* bboxes_ptr,
    bool* should_skip_ptr,
    const int num_threads) {
  const float sqrt_radius = sycl::sqrt(blur_radius);
  for (int f = tid; f < F; f += num_threads) {
    const float v0x = face_verts_ptr[f * 9 + 0 * 3 + 0];
    const float v0y = face_verts_ptr[f * 9 + 0 * 3 + 1];
    const float v0z = face_verts_ptr[f * 9 + 0 * 3 + 2];
    const float v1x = face_verts_ptr[f * 9 + 1 * 3 + 0];
    const float v1y = face_verts_ptr[f * 9 + 1 * 3 + 1];
    const float v1z = face_verts_ptr[f * 9 + 1 * 3 + 2];
    const float v2x = face_verts_ptr[f * 9 + 2 * 3 + 0];
    const float v2y = face_verts_ptr[f * 9 + 2 * 3 + 1];
    const float v2z = face_verts_ptr[f * 9 + 2 * 3 + 2];
    const float xmin = FloatMin3(v0x, v1x, v2x) - sqrt_radius;
    const float xmax = FloatMax3(v0x, v1x, v2x) + sqrt_radius;
    const float ymin = FloatMin3(v0y, v1y, v2y) - sqrt_radius;
    const float ymax = FloatMax3(v0y, v1y, v2y) + sqrt_radius;
    const float zmin = FloatMin3(v0z, v1z, v2z);
    const bool skip = zmin < kEpsilon;
    bboxes_ptr[0 * F + f] = xmin;
    bboxes_ptr[1 * F + f] = xmax;
    bboxes_ptr[2 * F + f] = ymin;
    bboxes_ptr[3 * F + f] = ymax;
    should_skip_ptr[f] = skip;
  }
}

inline void RasterizeCoarseSyclKernelBody(
    const int bin,
    const float* bboxes_ptr,
    const bool* should_skip_ptr,
    const int64_t* elem_first_idxs_ptr,
    const int64_t* elems_per_batch_ptr,
    int32_t* bin_elems_ptr,
    const int E,
    const int H,
    const int W,
    const int bin_size,
    const int M,
    const int num_bins_y,
    const int num_bins_x,
    sycl::stream output) {
  const int batch_idx = bin / (num_bins_y * num_bins_x);
  const int by = (bin / num_bins_x) % num_bins_y;
  const int bx = bin % num_bins_x;
  const float NDC_x_half_range = NonSquareNdcRange(W, H) / 2.0f;
  const float NDC_y_half_range = NonSquareNdcRange(H, W) / 2.0f;
  const float half_pix_x = NDC_x_half_range / W;
  const float half_pix_y = NDC_y_half_range / H;
  const float bin_y_min =
      PixToNonSquareNdc(by * bin_size, H, W) - half_pix_y;
  const float bin_y_max =
      PixToNonSquareNdc((by + 1) * bin_size - 1, H, W) + half_pix_y;
  const float bin_x_max =
      PixToNonSquareNdc((bx + 1) * bin_size - 1, W, H) + half_pix_x;
  const float bin_x_min =
      PixToNonSquareNdc(bx * bin_size, W, H) - half_pix_x;
  const int64_t elem_start_idx = elem_first_idxs_ptr[batch_idx];
  const int64_t elem_stop_idx =
      elem_start_idx + elems_per_batch_ptr[batch_idx];
  constexpr int chunk_size = 512;
  const int chunks_per_batch = 1 + (E - 1) / chunk_size;
  int count = 0;
  for (int chunk_idx = 0; chunk_idx < chunks_per_batch; ++chunk_idx) {
    const int elem_chunk_start_idx = chunk_idx * chunk_size;
    int chunk_count = 0;
    for (int e = 0; e < chunk_size; ++e) {
      const int e_idx = elem_chunk_start_idx + e;
      if (e_idx < elem_start_idx || e_idx >= elem_stop_idx ||
          should_skip_ptr[e_idx]) {
        continue;
      }
      const float xmin = bboxes_ptr[0 * E + e_idx];
      const float xmax = bboxes_ptr[1 * E + e_idx];
      const float ymin = bboxes_ptr[2 * E + e_idx];
      const float ymax = bboxes_ptr[3 * E + e_idx];
      const bool x_overlap = (xmin <= bin_x_max) && (bin_x_min < xmax);
      const bool y_overlap = (ymin <= bin_y_max) && (bin_y_min < ymax);
      chunk_count += y_overlap && x_overlap;
    }
    if (count + chunk_count <= M) {
      for (int e = 0; e < chunk_size; ++e) {
        const int e_idx = elem_chunk_start_idx + e;
        if (e_idx < elem_start_idx || e_idx >= elem_stop_idx ||
            should_skip_ptr[e_idx]) {
          continue;
        }
        const float xmin = bboxes_ptr[0 * E + e_idx];
        const float xmax = bboxes_ptr[1 * E + e_idx];
        const float ymin = bboxes_ptr[2 * E + e_idx];
        const float ymax = bboxes_ptr[3 * E + e_idx];
        const bool x_overlap = (xmin <= bin_x_max) && (bin_x_min < xmax);
        const bool y_overlap = (ymin <= bin_y_max) && (bin_y_min < ymax);
        if (y_overlap && x_overlap) {
          bin_elems_ptr[bin * M + count] = e_idx;
          ++count;
        }
      }
    } else {
      count += chunk_count;
    }
  }
  if (count > M) {
    const char* warning =
        "Bin size was too small in the coarse rasterization phase. "
        "This caused an overflow, meaning output may be incomplete. "
        "To solve, "
        "try increasing max_faces_per_bin / max_points_per_bin, "
        "decreasing bin_size, "
        "or setting bin_size to 0 to use the naive rasterization.";
    output << warning;
  }
}

} // namespace

at::Tensor RasterizeCoarseXpu(
    const at::Tensor& bboxes,
    const at::Tensor& should_skip,
    const at::Tensor& elem_first_idxs,
    const at::Tensor& elems_per_batch,
    const std::tuple<int, int> image_size,
    const int bin_size,
    const int max_elems_per_bin) {
  c10::DeviceGuard device_guard(bboxes.device());
  auto stream = c10::xpu::getCurrentXPUStream();

  const int H = std::get<0>(image_size);
  const int W = std::get<1>(image_size);

  const int E = bboxes.size(1);
  const int N = elems_per_batch.size(0);
  const int M = max_elems_per_bin;

  const int num_bins_y = 1 + (H - 1) / bin_size;
  const int num_bins_x = 1 + (W - 1) / bin_size;

  TORCH_CHECK(
      num_bins_y < kMaxItemsPerBin && num_bins_x < kMaxItemsPerBin,
      "In RasterizeCoarseXpu got num_bins_y: ", num_bins_y,
      ", num_bins_x: ", num_bins_x, "; that's too many!");

  auto opts = elems_per_batch.options().dtype(at::kInt);
  at::Tensor bin_elems = at::full({N, num_bins_y, num_bins_x, M}, -1, opts);

  if (bin_elems.numel() == 0) {
    return bin_elems;
  }

  auto bboxes_contiguous = bboxes.contiguous();
  auto should_skip_contiguous = should_skip.contiguous();
  auto elem_first_idxs_contiguous = elem_first_idxs.contiguous();
  auto elems_per_batch_contiguous = elems_per_batch.contiguous();

  const float* bboxes_ptr = bboxes_contiguous.data_ptr<float>();
  const bool* should_skip_ptr = should_skip_contiguous.data_ptr<bool>();
  const int64_t* elem_first_idxs_ptr = elem_first_idxs_contiguous.data_ptr<int64_t>();
  const int64_t* elems_per_batch_ptr = elems_per_batch_contiguous.data_ptr<int64_t>();
  int32_t* bin_elems_ptr = bin_elems.data_ptr<int32_t>();

  stream.queue().submit([&](handler& cgh) {
    sycl::stream output(8192, 1024, cgh);
    cgh.parallel_for<RasterizeCoarseSyclKernel>(
        range<1>(N * num_bins_y * num_bins_x),
        [=](id<1> item) {
          RasterizeCoarseSyclKernelBody(
              item[0],
              bboxes_ptr,
              should_skip_ptr,
              elem_first_idxs_ptr,
              elems_per_batch_ptr,
              bin_elems_ptr,
              E,
              H,
              W,
              bin_size,
              M,
              num_bins_y,
              num_bins_x,
              output);
        });
  });
  return bin_elems;
}

at::Tensor RasterizeMeshesCoarseXpu(
    const at::Tensor& face_verts,
    const at::Tensor& mesh_to_face_first_idx,
    const at::Tensor& num_faces_per_mesh,
    const std::tuple<int, int> image_size,
    const float blur_radius,
    const int bin_size,
    const int max_faces_per_bin) {
  TORCH_CHECK(
      face_verts.ndimension() == 3 && face_verts.size(1) == 3 &&
          face_verts.size(2) == 3 && face_verts.scalar_type() == at::kFloat,
      "face_verts must have dimensions (num_faces, 3, 3) and dtype float32");
  TORCH_CHECK(bin_size > 0 && max_faces_per_bin > 0, "invalid bin dimensions");
  TORCH_CHECK(
      face_verts.device().is_xpu() &&
          mesh_to_face_first_idx.device() == face_verts.device() &&
          num_faces_per_mesh.device() == face_verts.device(),
      "RasterizeMeshesCoarseXpu expects all inputs on the same XPU");

  c10::DeviceGuard device_guard(face_verts.device());
  auto stream = c10::xpu::getCurrentXPUStream();
  const int F = face_verts.size(0);
  auto float_opts = face_verts.options().dtype(at::kFloat);
  auto bool_opts = face_verts.options().dtype(at::kBool);
  at::Tensor bboxes = at::empty({4, F}, float_opts);
  at::Tensor should_skip = at::empty({F}, bool_opts);
  auto face_verts_contiguous = face_verts.contiguous();
  const float* face_verts_ptr = face_verts_contiguous.data_ptr<float>();
  float* bboxes_ptr = bboxes.data_ptr<float>();
  bool* should_skip_ptr = should_skip.data_ptr<bool>();

  const size_t blocks = 128;
  const size_t threads = 256;
  if (F > 0) {
    const int num_threads = blocks * threads;
    stream.queue().parallel_for<TriangleBoundingBoxKernel>(
        range<1>(blocks * threads),
        [=](id<1> item) {
          TriangleBoundingBoxSyclKernelBody(
              item[0],
              F,
              blur_radius,
              face_verts_ptr,
              bboxes_ptr,
              should_skip_ptr,
              num_threads);
        });
  }

  return RasterizeCoarseXpu(
      bboxes,
      should_skip,
      mesh_to_face_first_idx,
      num_faces_per_mesh,
      image_size,
      bin_size,
      max_faces_per_bin);
}